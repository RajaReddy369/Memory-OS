{
  "manifest_version": 3,
  "name": "MemoryOS Browser Agent",
  "version": "1.0.0",
  "description": "Continuous, private memory recorder and 3D cognitive roadmap for MemoryOS",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webNavigation",
    "sidePanel"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MemoryOS",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "world/*",
        "world.html",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
